# ===========================================
# DevineDesk Production Environment Variables
# ===========================================
# Copy this file to .env.production and fill in all values.
# Generate secrets with: openssl rand -base64 32

# ---- Server ----
NODE_ENV=production
PORT=4000
BACKEND_URL=https://devinedesk.com
FRONTEND_URL=https://devinedesk.com

# ---- Database ----
POSTGRES_USER=devinedesk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=devinedesk

# ---- Auth ----
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- SMTP (Resend) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxx
SMTP_FROM=DevineDesk <noreply@devinedesk.com>

# ---- Admin emails ----
ADMIN_EMAILS=you@example.com
SUPERADMIN_EMAILS=you@example.com

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_THUMBNAIL_MODEL=google/gemini-3.1-flash-image
OPENROUTER_THUMBNAIL_FALLBACK_MODELS=bytedance-seed/seedream-4.5,black-forest-labs/flux.2-klein-4b
OPENROUTER_SWAP_MODEL=black-forest-labs/flux.2-klein-4b

# ---- Face-swap ----
SWAP_PROVIDER=facefusion
FACEFUSION_URL=http://facefusion:7865
RENDER_BLOCK_CONCURRENCY=3
RENDER_VIDEO_MAX_ATTEMPTS=3

# ---- Dodo Payments ----
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_IDS=pdt_starter,pdt_pro,pdt_studio

# ---- Credits ----
CREDITS_PER_IMAGE=6
CREDITS_PER_VIDEO=60
CREDITS_PER_TEMPLATE_RENDER=1000
USD_INR_RATE=86

# ---- Redis (BullMQ job queue for durable video generation) ----
# Set automatically by docker-compose.deploy.yml as redis://redis:6379
# REDIS_URL=redis://redis:6379

# ---- MinIO ----
# MINIO_ENDPOINT is the internal hostname used by the backend to talk to MinIO
# (set automatically by docker-compose to "minio"). MINIO_FRONTEND_ENDPOINT is
# the public-facing host users' browsers use to fetch generated media. When
# behind the production nginx proxy, set it to "devinedesk.com/minio" and
# MINIO_PORT=443 / MINIO_USE_SSL=true so URLs become
# https://devinedesk.com/minio/<bucket>/<key>.
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=devinedesk
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_FRONTEND_ENDPOINT=minio.devinedesk.com

# ---- Sentry (error tracking) ----
# Backend DSN from your Sentry project settings.
SENTRY_DSN=
# Frontend DSN (passed to Vite at build time as VITE_SENTRY_DSN).
# Add VITE_SENTRY_DSN=... to the frontend build args in docker-compose.deploy.yml.
