# Database
DATABASE_URL="file:./dev.db" # Or postgresql://... for production
REDIS_URL="redis://127.0.0.1:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (NextAuth & API)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-key"
LOCAL_API_KEY="devinedesk-local-dev-key"

# Stripe Billing (Required for production payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AWS S3 / Cloudflare R2 Storage (Required for production image/video uploads)
AWS_REGION="auto"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
S3_BUCKET_NAME="devinedesk-assets"
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com" # Optional, used for R2

# External AI Providers (Required for backend media generation)
OPENROUTER_API_KEY="sk-or-..."
AIMLAPI_KEY="..."
FAL_KEY="..."
HF_TOKEN="hf_..."
GOAPI_KEY="..."

# Python FastAPI Backend
NEXT_PUBLIC_PYTHON_BACKEND_URL="http://localhost:8000"
